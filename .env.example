# openssl rand -hex 24   (hex: it goes into a URL, so no / + = characters)
POSTGRES_PASSWORD=

# Where clients reach the gateway, if behind a proxy/LB. Unset = derived from each request.
PUBLIC_BASE_URL=

# postgres = keys managed with `admin key:create`; static = keys listed in STATIC_KEYS
AUTH_PROVIDER=postgres
# STATIC_KEYS=[{"key":"fcgw_…","team":"acme","monthlyCredits":50000,"rateMultiplier":1}]

# Requests per minute per team (bucket = one minute's worth), before the team's multiplier
RATE_SCRAPE_PER_MIN=100
RATE_CRAWL_PER_MIN=15
RATE_STATUS_PER_MIN=1500
# open = serve without rate limits while Redis is down (credits still enforced); closed = 429
RATE_LIMIT_FAIL_MODE=open
LOG_LEVEL=info
