{
  "name": "firecrawl-selfhost-gateway",
  "version": "0.1.0",
  "description": "API keys, rate limits and credit metering in front of a self-hosted Firecrawl API, with per-team job isolation.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/src/bin/gateway.js",
    "admin": "node dist/src/bin/admin.js",
    "mock": "node dist/mock/firecrawl-mock.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
